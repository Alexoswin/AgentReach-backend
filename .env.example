PORT=3001
DATABASE_URL=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
JWT_SECRET=
PUBLIC_API_URL=https://your-public-backend.example.com/api
PUBLIC_WS_URL=wss://your-public-backend.example.com
CREDENTIAL_ENCRYPTION_KEY=
# Optional bootstrap fallback. The encrypted Gemini key saved in Settings takes precedence.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025


# Frontend origin, used for password-reset links (required in production).
PUBLIC_APP_URL=https://agentreach-frontend.vercel.app
# Comma-separated origins allowed by CORS. Empty = allow all.
CORS_ORIGINS=https://agentreach-frontend.vercel.app
# Data is shared across all accounts, so sign-up is closed in production
# unless ALLOW_REGISTRATION=true or the email is on the allowlist.
ALLOW_REGISTRATION=
ALLOWED_SIGNUP_EMAILS=
# Optional first-run account; created only if that email does not exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Default SES sender for a fresh settings record.
AWS_SENDER_EMAIL=
# Serve Swagger at /docs in production.
ENABLE_SWAGGER=false
