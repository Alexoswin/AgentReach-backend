PORT=3001
DATABASE_URL=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
JWT_SECRET=
PUBLIC_API_URL=https://your-public-backend.example.com/api
PUBLIC_WS_URL=wss://your-public-backend.example.com
CREDENTIAL_ENCRYPTION_KEY=
# Optional bootstrap fallback. The encrypted Gemini key saved in Settings takes precedence.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# --- Trade-Agent ---
# Note: CREDENTIAL_ENCRYPTION_KEY above becomes REQUIRED once any Groww
# credential is saved - the backend refuses to store broker credentials
# without it. Use 32+ random characters: openssl rand -base64 48

# NSE trading holidays for the current year, comma-separated YYYY-MM-DD.
# Deliberately not hardcoded: a stale list silently trades on a closed day.
# Take these from the official NSE holiday circular each year.
# Auto execution mode refuses to run until this is set.
NSE_TRADING_HOLIDAYS=
