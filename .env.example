PORT=3001
DATABASE_URL=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
JWT_SECRET=
PUBLIC_API_URL=https://your-public-backend.example.com/api
CREDENTIAL_ENCRYPTION_KEY=

# AI calling runtime tuning (optional)
AI_CALLING_MODE=gemini_live
AI_CALLING_ALLOW_TWILIO_GATHER_FALLBACK=false
# Optional if Settings Google JSON contains apiKey/api_key, geminiApiKey/gemini_api_key, or googleApiKey/google_api_key.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_PREFLIGHT_TIMEOUT_MS=5000
GEMINI_LIVE_LAUNCH_TIMEOUT_MS=20000
GEMINI_LIVE_READY_CACHE_MS=60000
VERTEX_LOCATION=global
VERTEX_FALLBACK_MODELS=gemini-2.5-flash-native-audio-preview-12-2025,gemini-2.5-flash,gemini-2.0-flash-001,gemini-1.5-flash-002
AI_CALLING_CHAT_MODEL=gemini-2.5-flash
AI_CALLING_EMBEDDING_MODEL=text-embedding-005
AI_CALLING_DEFAULT_TOP_K=5
AI_CALLING_MAX_TOP_K=10
AI_CALLING_RAC_TOP_K=4
AI_CALLING_RAC_CONTACT_TURN_LIMIT=3
AI_CALLING_RAC_HISTORY_LINE_LIMIT=6
AI_CALLING_FAST_PATH_ENABLED=true
AI_CALLING_TRAIN_CHUNK_SIZE=900
AI_CALLING_TRAIN_CHUNK_OVERLAP=120
AI_CALLING_MAX_TRAINING_PDF_BYTES=8388608
AI_CALLING_MIN_TRAINING_TEXT_LENGTH=40
AI_CALLING_EMBEDDING_BATCH_SIZE=32
AI_CALLING_PROMPT_EXPOSURE_TERMS=system prompt,prompt,instructions,hidden instructions,developer message,jailbreak,ignore previous,reveal your rules,show your rules
AI_CALLING_IMMEDIATE_END_TERMS=bye,goodbye,not interested,wrong number,stop calling,remove me,don't call,do not call,no thanks,no thank you
GOOGLE_CLOUD_SCOPE=https://www.googleapis.com/auth/cloud-platform
TWILIO_HD_PLAY_ENABLED=true
TWILIO_RESPONSE_BUDGET_MS=5000
TWILIO_SPEECH_TIMEOUT_SECONDS=1
GOOGLE_TTS_TIMEOUT_MS=3500
VERTEX_TWILIO_TIMEOUT_MS=2500
